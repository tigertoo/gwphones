# Example systemd unit: copy to /etc/systemd/system/gwphones.service.
#
# sudo systemctl daemon-reload
# sudo systemctl enable --now gwphones
# sudo systemctl status gwphones
#
# On the development VPS it keeps the setup it had inside the admin
# dashboard (see README.md, "On the server"): the admindash user, in the
# asterisk group, port 8010, data in /var/lib/admin-dashboard. Only the
# code (/opt/gwphones) and the unit's name are new. Never run two copies:
# each rewrites the Asterisk files at start.

[Unit]
Description=gwphones phone platform API
After=network.target

[Service]
Type=simple
User=admindash
Group=admindash
SupplementaryGroups=asterisk
WorkingDirectory=/opt/gwphones/backend
EnvironmentFile=/opt/gwphones/backend/.env
Environment=HOME=/var/lib/admin-dashboard
Environment=PBX_GENERATED_DIR=/etc/asterisk/portal
ExecStart=/opt/gwphones/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5

# Lockdown: everything read-only except its own data, logs, the Asterisk
# folder it generates, Asterisk's control socket, the voicemail outbox and
# the recordings.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/admin-dashboard /var/log/admin-dashboard /etc/asterisk/portal -/run/asterisk -/var/spool/asterisk/vm-outbox
ReadWritePaths=-/var/spool/asterisk/monitor/portal
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
